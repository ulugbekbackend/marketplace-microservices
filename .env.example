# Copy to .env and adjust. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*

# Postgres (one container, one database per service)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://marketplace:change-me@rabbitmq:5672/

# Object storage (S3 compatible)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://minio.localhost
S3_ACCESS_KEY=marketplace
S3_SECRET_KEY=change-me
S3_BUCKET=marketplace

# Search
ELASTICSEARCH_URL=http://elasticsearch:9200

# Auth
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# SMS / notifications
SMS_BACKEND=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=mailpit
SMTP_PORT=1025

# Payments
PAYMENT_MOCK_ENABLED=True
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
