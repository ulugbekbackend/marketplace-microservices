    "/api/auth/token/refresh/": {
      "post": {
        "operationId": "token_refresh_create",
        "description": "No gateway identity needed: the caller proves itself with a code or a token.",
        "summary": "Exchange a refresh token for a new pair; the old refresh is revoked",
        "tags": ["token"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "security": [{}],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid input"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/auth/verify/": {
      "get": {
        "operationId": "verify_retrieve",
        "description": "Traefik ForwardAuth target.\n\nThe signature and expiry are checked locally with the public key; then one primary key\nlookup confirms the account is still active and reads its current role, so a blocked user\nor a revoked role stops working at once rather than when the access token expires.",
        "summary": "Gateway token check (ForwardAuth)",
        "parameters": [
          {
            "in": "query",
            "name": "optional",
            "schema": {
              "type": "integer",
              "enum": [0, 1]
            },
            "description": "1: a request without a token passes as a guest (no headers)."
          }
        ],
        "tags": ["verify"],
        "security": [{}],
        "responses": {
          "200": {
            "headers": {
              "X-User-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Verified user id."
              },
              "X-User-Role": {
                "schema": {
                  "type": "string"
                },
                "description": "Verified role."
              },
              "X-Seller-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Seller id (the user id); sellers only."
              }
            },
            "description": "No response body"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not authenticated"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminSellerApplication": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Applicant"
              }
            ],
            "readOnly": true
          },
          "shop_name": {
            "type": "string",
            "readOnly": true
          },
          "inn": {
            "type": "string",
            "readOnly": true
          },
          "description": {
            "type": "string",
            "readOnly": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StatusEnum"
              }
            ],
            "readOnly": true
          },
          "reviewed_by": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "nullable": true
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "created_at",
          "description",
          "id",
          "inn",
          "reviewed_at",
          "reviewed_by",
          "shop_name",
          "status",
          "user"
        ]
      },
      "Applicant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "phone": {
            "type": "string",
            "readOnly": true
          },
          "full_name": {
            "type": "string",
            "readOnly": true
          }
        },
        "required": ["full_name", "id", "phone"]
      },
      "Error": {
        "type": "object",
        "description": "The shared error shape: {\"error\": {\"code\", \"message\", \"details\"}}.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": ["error"]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": ["code", "details", "message"]
      },
      "Jwk": {
        "type": "object",
        "properties": {
          "kty": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "alg": {
            "type": "string"
          },
          "kid": {
            "type": "string"
          },
          "n": {
            "type": "string"
          },
          "e": {
            "type": "string"
          }
        },
        "required": ["alg", "e", "kid", "kty", "n", "use"]
      },
      "Jwks": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Jwk"
            }
          }
        },
        "required": ["keys"]
      },
      "Login": {
        "type": "object",
        "properties": {
          "access": {
            "type": "string"
          },
          "refresh": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["access", "refresh", "user"]
      },
      "OtpSendRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "required": ["phone"]
      },
      "OtpVerifyRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6,
            "pattern": "^\\d{6}$"
          }
        },
        "required": ["code", "phone"]
      },
      "PaginatedAdminSellerApplicationList": {
        "type": "object",
        "required": ["items", "total", "page", "page_size"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminSellerApplication"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "PatchedUserUpdateRequest": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refresh": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["refresh"]
      },
      "RoleEnum": {
        "enum": ["customer", "seller", "admin"],
        "type": "string",
        "description": "* `customer` - Customer\n* `seller` - Seller\n* `admin` - Admin"
      },
      "SellerApplication": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "shop_name": {
            "type": "string",
            "readOnly": true
          },
          "inn": {
            "type": "string",
            "readOnly": true
          },
          "description": {
            "type": "string",
            "readOnly": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StatusEnum"
              }
            ],
            "readOnly": true
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": ["created_at", "description", "id", "inn", "reviewed_at", "shop_name", "status"]
      },
      "SellerApplyRequest": {
        "type": "object",
        "properties": {
          "shop_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "inn": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d{9}$",
            "maxLength": 9
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["inn", "shop_name"]
      },
      "StatusEnum": {
        "enum": ["pending", "approved", "rejected"],
        "type": "string",
        "description": "* `pending` - Pending\n* `approved` - Approved\n* `rejected` - Rejected"
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "access": {
            "type": "string"
          },
          "refresh": {
            "type": "string"
          }
        },
        "required": ["access", "refresh"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "phone": {
            "type": "string",
            "readOnly": true
          },
          "full_name": {
            "type": "string",
            "readOnly": true
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoleEnum"
              }
            ],
            "readOnly": true
          },
          "date_joined": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": ["date_joined", "full_name", "id", "phone", "role"]
      }
    },
    "securitySchemes": {
      "gatewayBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token; the gateway verifies it and forwards the identity."
      }
    }
  }
}
