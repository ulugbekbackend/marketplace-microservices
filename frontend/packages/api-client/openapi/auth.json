    "/api/auth/.well-known/jwks.json": {
      "get": {
        "operationId": ".well_known_jwks.json_retrieve",
        "description": "No gateway identity needed: the caller proves itself with a code or a token.",
        "summary": "Public signing keys (JWKS)",
