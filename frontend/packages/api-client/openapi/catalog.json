          }
        ],
        "tags": ["seller"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VariantCreateRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/VariantCreateRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/VariantCreateRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerVariant"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/seller/uploads/presign/": {
      "post": {
        "operationId": "seller_uploads_presign",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "tags": ["seller"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignRequestRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PresignRequestRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PresignRequestRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/seller/variants/{variant_id}/": {
      "patch": {
        "operationId": "seller_variants_update",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "parameters": [
          {
            "in": "path",
            "name": "variant_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["seller"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchedVariantUpdateRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatchedVariantUpdateRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatchedVariantUpdateRequest"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerVariant"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/seller/variants/{variant_id}/stock/": {
      "patch": {
        "operationId": "seller_variants_stock_update",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "parameters": [
          {
            "in": "path",
            "name": "variant_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["seller"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchedStockUpdateRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatchedStockUpdateRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatchedStockUpdateRequest"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerVariant"
                }
              }
            },
            "description": ""
          },
          "409": {
            "description": "STOCK_BELOW_RESERVED, details.reserved"
          }
        }
      }
    },
    "/api/catalog/shops/{slug}/": {
      "get": {
        "operationId": "shops_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": ["catalog"],
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shop"
                }
              }
            },
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attribute": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "code": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[-a-zA-Z0-9_]+$"
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttributeValue"
            },
            "readOnly": true
          }
        },
        "required": ["code", "id", "name", "values"]
      },
      "AttributeValue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "value": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": ["id", "value"]
      },
      "CategoryNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryNode"
            }
          }
        },
        "required": ["children", "id", "name", "slug"]
      },
      "CategoryRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "slug": {
            "type": "string",
            "maxLength": 140,
            "pattern": "^[-a-zA-Z0-9_]+$"
          }
        },
        "required": ["id", "name", "slug"]
      },
      "Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "position": {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 0
          },
          "thumb_url": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "medium_url": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "large_url": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          }
        },
        "required": ["id", "large_url", "medium_url", "thumb_url"]
      },
      "ImageAttachRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": ["key"]
      },
      "ImageContentTypeEnum": {
        "enum": ["image/jpeg", "image/png", "image/webp"],
        "type": "string",
        "description": "* `image/jpeg` - image/jpeg\n* `image/png` - image/png\n* `image/webp` - image/webp"
      },
      "ImageStatusEnum": {
        "enum": ["processing", "ready", "failed"],
        "type": "string",
        "description": "* `processing` - Processing\n* `ready` - Ready\n* `failed` - Failed"
      },
      "PaginatedProductCardList": {
        "type": "object",
        "required": ["items", "total", "page", "page_size"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductCard"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "PaginatedSellerProductList": {
        "type": "object",
        "required": ["items", "total", "page", "page_size"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SellerProduct"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "PatchedProductUpdateRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "category_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/ProductStatusEnum"
          }
        }
      },
      "PatchedStockUpdateRequest": {
        "type": "object",
        "properties": {
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PatchedVariantUpdateRequest": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "price_tiyin": {
            "type": "integer",
            "minimum": 1
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "PresignRequestRequest": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid",
            "description": "The seller's product the image is for."
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "content_type": {
            "$ref": "#/components/schemas/ImageContentTypeEnum"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "description": "File size in bytes."
          }
        },
        "required": ["content_type", "filename", "product_id", "size"]
      },
      "PresignResponse": {
        "type": "object",
        "properties": {
          "upload_url": {
            "type": "string",
            "format": "uri",
            "description": "PUT the file here."
          },
          "key": {
            "type": "string",
            "description": "Send it to the images endpoint after the upload."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers the PUT request must carry."
          },
          "method": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "description": "Seconds the URL stays valid."
          }
        },
        "required": ["expires_in", "headers", "key", "method", "upload_url"]
      },
      "ProductCard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "slug": {
            "type": "string",
            "maxLength": 220,
            "pattern": "^[-a-zA-Z0-9_]+$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "min_price_tiyin": {
            "type": "integer",
            "readOnly": true,
            "nullable": true,
            "description": "Lowest active variant price, tiyin."
          },
          "max_price_tiyin": {
            "type": "integer",
            "readOnly": true,
            "nullable": true,
            "description": "Highest active variant price, tiyin."
          },
          "in_stock": {
            "type": "boolean",
            "readOnly": true
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "seller": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SellerCard"
              }
            ],
            "readOnly": true
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryRef"
              }
            ],
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "category",
          "created_at",
          "id",
          "image_url",
          "in_stock",
          "max_price_tiyin",
          "min_price_tiyin",
          "seller",
          "slug",
          "title"
        ]
      },
      "ProductCreateRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "default": ""
          },
