{
  "openapi": "3.0.3",
  "info": {
    "title": "Catalog service",
    "version": "0.1.0"
  },
  "paths": {
    "/api/catalog/attributes/": {
      "get": {
        "operationId": "attributes_list",
        "description": "Attributes with their values, for building the variant matrix.",
        "tags": ["seller"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Attribute"
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/categories/": {
      "get": {
        "operationId": "categories_tree",
        "tags": ["catalog"],
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryNode"
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/products/": {
      "get": {
        "operationId": "products_list",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string"
            },
            "description": "Category slug; products of subcategories too."
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "A page number within the paginated result set.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "seller",
            "schema": {
              "type": "string"
            },
            "description": "Shop slug."
          }
        ],
        "tags": ["catalog"],
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedProductCardList"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/products/{slug}/": {
      "get": {
        "operationId": "products_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": ["catalog"],
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetail"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/seller/products/": {
      "get": {
        "operationId": "seller_products_list",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "A page number within the paginated result set.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "description": "Search in title, slug and SKU."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": ["active", "archived", "draft"]
            },
            "description": "* `draft` - Draft\n* `active` - Active\n* `archived` - Archived"
          }
        ],
        "tags": ["seller"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedSellerProductList"
                }
              }
            },
            "description": ""
          }
        }
      },
      "post": {
        "operationId": "seller_products_create",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "tags": ["seller"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreateRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreateRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreateRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerProductDetail"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/seller/products/{product_id}/": {
      "get": {
        "operationId": "seller_products_retrieve",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["seller"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerProductDetail"
                }
              }
            },
            "description": ""
          }
        }
      },
      "patch": {
        "operationId": "seller_products_update",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["seller"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchedProductUpdateRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatchedProductUpdateRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatchedProductUpdateRequest"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerProductDetail"
                }
              }
            },
            "description": ""
          }
        }
      },
      "delete": {
        "operationId": "seller_products_archive",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["seller"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Archived (soft delete)."
          }
        }
      }
    },
    "/api/catalog/seller/products/{product_id}/images/": {
      "post": {
        "operationId": "seller_images_create",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "schema": {
              "type": "string",
