        "tags": ["seller"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageAttachRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ImageAttachRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImageAttachRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerImage"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/catalog/seller/products/{product_id}/variants/": {
      "post": {
        "operationId": "seller_variants_create",
        "description": "Resolves the caller's shop after the IsSeller check; unknown shops get 403.",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "schema": {
              "type": "string",
