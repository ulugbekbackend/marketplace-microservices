{
  "openapi": "3.0.3",
  "info": {
    "title": "Order service",
    "version": "0.1.0"
  },
  "paths": {
    "/api/orders/": {
      "get": {
        "operationId": "orders_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "A page number within the paginated result set.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "tags": ["orders"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedOrderSummaryList"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          }
        }
      }
    },
    "/api/orders/{order_id}/": {
      "get": {
        "operationId": "orders_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["orders"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_FOUND: no such order of the current user"
          }
        }
      }
    },
    "/api/orders/{order_id}/cancel/": {
      "post": {
        "operationId": "orders_cancel",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["orders"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_FOUND: no such order of the current user"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INVALID_TRANSITION: only PENDING or RESERVED"
          }
        }
      }
    },
    "/api/orders/{order_id}/pay/mock/": {
      "post": {
        "operationId": "orders_pay_mock",
        "description": "Takes the same path as a payment.paid event from a provider. Exists only when PAYMENT_MOCK_ENABLED and DEBUG are on; 404 otherwise.",
        "summary": "Pay an order without a provider (development only)",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["orders"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_FOUND: no such order of the current user"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_RESERVED: still PENDING, try again shortly; ORDER_EXPIRED; INVALID_TRANSITION: cancelled or refunded"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "SERVICE_UNAVAILABLE: catalog did not answer (commission rates)"
          }
        }
      }
    },
    "/api/orders/{order_id}/status/": {
      "get": {
        "operationId": "orders_status",
        "summary": "Order status for polling",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["orders"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderStatus"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_FOUND: no such order of the current user"
          }
        }
      }
    },
    "/api/orders/checkout/": {
      "post": {
        "operationId": "orders_checkout",
        "description": "Snapshots current catalog prices and creates a PENDING order; the catalog reserves its stock asynchronously. Poll the status endpoint: PENDING turns into RESERVED (pay before reserved_until) or CANCELLED with cancel_reason OUT_OF_STOCK when the stock could not be held. Retries with the same Idempotency-Key and body replay the first answer.",
        "summary": "Create an order from the cart",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string"
            },
            "description": "Unique per checkout attempt (e.g. a UUID), at most 255 characters.",
            "required": true
          }
        ],
        "tags": ["orders"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResult"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_ERROR, IDEMPOTENCY_KEY_REQUIRED, IDEMPOTENCY_KEY_INVALID"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "CART_EMPTY; ITEMS_UNAVAILABLE with details.items[{variant_id, reason (not_found|inactive|out_of_stock), available}]; IDEMPOTENCY_KEY_REUSED; IDEMPOTENCY_IN_PROGRESS"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "SERVICE_UNAVAILABLE: cart, catalog or redis did not answer"
          }
        }
      }
    },
    "/api/orders/seller/": {
      "get": {
        "operationId": "seller_orders_list",
        "summary": "Sub-orders of the current seller, newest first",
        "parameters": [
          {
            "in": "query",
            "name": "date_from",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "First day, inclusive (Asia/Tashkent)."
          },
          {
            "in": "query",
            "name": "date_to",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Last day, inclusive (Asia/Tashkent)."
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "A page number within the paginated result set.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["ACCEPTED", "CANCELLED_BY_SELLER", "DELIVERED", "NEW", "SHIPPED"]
              }
            },
            "description": "Repeat the parameter or pass a comma separated list."
          }
        ],
        "tags": ["seller-orders"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedSellerSubOrderList"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_ERROR: unknown status or bad date"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "PERMISSION_DENIED: seller role required"
          }
        }
      }
    },
    "/api/orders/seller/{sub_order_id}/": {
      "get": {
        "operationId": "seller_orders_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "sub_order_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["seller-orders"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerSubOrderDetail"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "PERMISSION_DENIED: seller role required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_FOUND: no such sub-order of this seller"
          }
        }
      }
    },
    "/api/orders/seller/{sub_order_id}/status/": {
      "patch": {
        "operationId": "seller_orders_set_status",
        "description": "Allowed: NEW -> ACCEPTED | CANCELLED_BY_SELLER, ACCEPTED -> SHIPPED | CANCELLED_BY_SELLER, SHIPPED -> DELIVERED. SHIPPED needs tracking_number, CANCELLED_BY_SELLER needs reason. The order moves to FULFILLING with the first shipment and to COMPLETED once every sub-order that was not cancelled is delivered.",
        "summary": "Accept, ship, deliver or cancel a sub-order",
        "parameters": [
          {
            "in": "path",
            "name": "sub_order_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": ["seller-orders"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchedSubOrderStatusChangeRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatchedSubOrderStatusChangeRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatchedSubOrderStatusChangeRequest"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerSubOrderDetail"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_ERROR: unknown status, missing tracking_number or reason"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "PERMISSION_DENIED: seller role required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_FOUND: no such sub-order of this seller"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INVALID_TRANSITION with details {from, to}; ORDER_NOT_ACTIVE with details {order_status}"
          }
        }
      }
    },
    "/api/orders/seller/stats/": {
      "get": {
        "operationId": "seller_orders_stats",
        "description": "Days, ISO weeks and calendar months in Asia/Tashkent. Sub-orders cancelled by the seller are left out of orders/gross/net but counted in by_status. net = gross - commission. daily covers the last 30 days including today.",
        "summary": "Dashboard numbers of the current seller",
        "tags": ["seller-orders"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerStats"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "NOT_AUTHENTICATED"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "PERMISSION_DENIED: seller role required"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^\\+?[0-9][0-9 ()-]{6,19}$"
          },
          "region": {
            "type": "string",
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "street": {
            "type": "string",
            "maxLength": 255
          },
          "notes": {
            "type": "string",
            "default": "",
            "maxLength": 500
          }
        },
        "required": ["city", "full_name", "phone", "region", "street"]
      },
      "AddressRequest": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\+?[0-9][0-9 ()-]{6,19}$"
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "street": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "notes": {
            "type": "string",
            "default": "",
            "maxLength": 500
          }
        },
        "required": ["city", "full_name", "phone", "region", "street"]
      },
      "CheckoutRequest": {
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/AddressRequest"
          }
        },
        "required": ["address"]
      },
      "CheckoutResult": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatusEnum"
          }
        },
        "required": ["order_id", "status"]
      },
      "DailyStats": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "integer"
          },
          "gross_tiyin": {
            "type": "integer"
          },
          "net_tiyin": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": ["date", "gross_tiyin", "net_tiyin", "orders"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": ["error"]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": ["code", "details", "message"]
      },
      "NullEnum": {
        "enum": [null]
      },
      "OrderDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OrderStatusEnum"
              }
            ],
            "readOnly": true
          },
          "total_tiyin": {
            "type": "integer",
            "readOnly": true
          },
          "delivery_address": {
            "$ref": "#/components/schemas/Address"
          },
          "reserved_until": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true
          },
          "late_payment": {
            "type": "boolean",
            "readOnly": true
          },
          "cancel_reason": {
            "type": "string",
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "sellers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SellerGroup"
            },
            "readOnly": true
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderHistory"
            }
          }
        },
        "required": [
          "cancel_reason",
          "created_at",
          "delivery_address",
          "history",
          "id",
          "late_payment",
          "reserved_until",
          "sellers",
          "status",
          "total_tiyin",
          "updated_at"
        ]
      },
      "OrderHistory": {
        "type": "object",
        "properties": {
          "from_status": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/OrderStatusEnum"
              },
              {
                "$ref": "#/components/schemas/NullEnum"
              }
            ]
          },
          "to_status": {
            "$ref": "#/components/schemas/OrderStatusEnum"
          },
          "reason": {
            "type": "string",
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": ["created_at", "from_status", "reason", "to_status"]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "variant_id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "title": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "price_tiyin": {
            "type": "integer"
          },
          "qty": {
            "type": "integer",
            "readOnly": true
          },
          "line_total_tiyin": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "image_url",
          "line_total_tiyin",
          "price_tiyin",
          "qty",
          "sku",
          "title",
          "variant_id"
        ]
      },
      "OrderStatus": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OrderStatusEnum"
              }
            ],
            "readOnly": true
          },
          "reserved_until": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true
          }
        },
        "required": ["reserved_until", "status"]
      },
      "OrderStatusEnum": {
        "enum": [
          "PENDING",
          "RESERVED",
          "PAID",
          "FULFILLING",
          "COMPLETED",
          "EXPIRED",
          "CANCELLED",
          "REFUNDED"
        ],
        "type": "string",
        "description": "* `PENDING` - Pending\n* `RESERVED` - Reserved\n* `PAID` - Paid\n* `FULFILLING` - Fulfilling\n* `COMPLETED` - Completed\n* `EXPIRED` - Expired\n* `CANCELLED` - Cancelled\n* `REFUNDED` - Refunded"
      },
      "OrderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OrderStatusEnum"
              }
            ],
            "readOnly": true
          },
          "total_tiyin": {
            "type": "integer",
            "readOnly": true
          },
          "items_count": {
            "type": "integer",
            "readOnly": true
          },
          "reserved_until": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": ["created_at", "id", "items_count", "reserved_until", "status", "total_tiyin"]
      },
      "PaginatedOrderSummaryList": {
        "type": "object",
        "required": ["items", "total", "page", "page_size"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "PaginatedSellerSubOrderList": {
        "type": "object",
        "required": ["items", "total", "page", "page_size"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SellerSubOrder"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          }
        }
      },
      "PatchedSubOrderStatusChangeRequest": {
        "type": "object",
        "description": "SHIPPED needs a tracking number, CANCELLED_BY_SELLER a reason.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SubOrderTargetStatusEnum"
          },
          "tracking_number": {
            "type": "string",
            "maxLength": 64
          },
          "reason": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "PeriodStats": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "integer"
          },
          "gross_tiyin": {
            "type": "integer"
          },
          "net_tiyin": {
            "type": "integer"
          }
        },
        "required": ["gross_tiyin", "net_tiyin", "orders"]
      },
      "SellerGroup": {
        "type": "object",
        "description": "The items of one seller. Sub-order fields stay null (history empty) until payment.",
        "properties": {
          "seller_id": {
            "type": "string",
            "format": "uuid"
          },
          "shop_name": {
            "type": "string"
          },
          "sub_order_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "status": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/SubOrderStatusEnum"
              },
              {
                "$ref": "#/components/schemas/NullEnum"
              }
            ]
          },
          "tracking_number": {
            "type": "string",
            "nullable": true
          },
          "cancel_reason": {
            "type": "string",
            "nullable": true
          },
          "subtotal_tiyin": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubOrderHistory"
            }
          }
        },
        "required": [
          "cancel_reason",
          "history",
          "items",
          "seller_id",
          "shop_name",
          "status",
          "sub_order_id",
          "subtotal_tiyin",
          "tracking_number"
        ]
      },
      "SellerItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "variant_id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "title": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "price_tiyin": {
            "type": "integer"
          },
          "qty": {
            "type": "integer",
            "readOnly": true
          },
          "line_total_tiyin": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "image",
          "line_total_tiyin",
          "price_tiyin",
          "qty",
          "sku",
          "title",
          "variant_id"
        ]
      },
      "SellerStats": {
        "type": "object",
        "description": "Tashkent today / ISO week / calendar month, the last 30 days and per-status counts.",
        "properties": {
          "today": {
            "$ref": "#/components/schemas/PeriodStats"
          },
          "week": {
            "$ref": "#/components/schemas/PeriodStats"
          },
          "month": {
            "$ref": "#/components/schemas/PeriodStats"
          },
          "daily": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyStats"
            }
          },
          "by_status": {
            "$ref": "#/components/schemas/StatusCounts"
          }
        },
        "required": ["by_status", "daily", "month", "today", "week"]
      },
      "SellerSubOrder": {
        "type": "object",
        "description": "A row of the seller list. Needs ``items_count`` annotated and ``order`` joined.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "order_id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "status": {
            "$ref": "#/components/schemas/SubOrderStatusEnum"
          },
          "subtotal_tiyin": {
            "type": "integer",
            "readOnly": true
          },
          "commission_tiyin": {
            "type": "integer",
            "readOnly": true
          },
          "net_tiyin": {
            "type": "integer",
            "readOnly": true
          },
          "items_count": {
            "type": "integer",
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "customer_name": {
            "type": "string",
            "readOnly": true
          },
          "city": {
            "type": "string",
            "readOnly": true
          }
        },
        "required": [
          "city",
          "commission_tiyin",
          "created_at",
          "customer_name",
          "id",
          "items_count",
          "net_tiyin",
          "order_id",
          "status",
          "subtotal_tiyin",
          "updated_at"
        ]
      },
      "SellerSubOrderDetail": {
        "type": "object",
        "description": "One sub-order with everything needed to ship it, including the customer's phone.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "order_id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "status": {
            "$ref": "#/components/schemas/SubOrderStatusEnum"
          },
          "subtotal_tiyin": {
            "type": "integer",
            "readOnly": true
          },
          "commission_tiyin": {
            "type": "integer",
            "readOnly": true
          },
          "net_tiyin": {
            "type": "integer",
            "readOnly": true
          },
          "items_count": {
            "type": "integer",
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "customer_name": {
            "type": "string",
            "readOnly": true
          },
          "city": {
            "type": "string",
            "readOnly": true
          },
          "commission_rate": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,1}(?:\\.\\d{0,4})?$"
          },
          "tracking_number": {
            "type": "string",
            "readOnly": true
          },
          "cancel_reason": {
            "type": "string",
            "readOnly": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SellerItem"
            }
          },
          "delivery_address": {
            "$ref": "#/components/schemas/Address"
          },
          "order_status": {
            "$ref": "#/components/schemas/OrderStatusEnum"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubOrderHistory"
            }
          }
        },
        "required": [
          "cancel_reason",
          "city",
          "commission_rate",
          "commission_tiyin",
          "created_at",
          "customer_name",
          "delivery_address",
          "history",
          "id",
          "items",
          "items_count",
          "net_tiyin",
          "order_id",
          "order_status",
          "status",
          "subtotal_tiyin",
          "tracking_number",
          "updated_at"
        ]
      },
      "StatusCounts": {
        "type": "object",
        "properties": {
          "NEW": {
            "type": "integer"
          },
          "ACCEPTED": {
            "type": "integer"
          },
          "SHIPPED": {
            "type": "integer"
          },
          "DELIVERED": {
            "type": "integer"
          },
          "CANCELLED_BY_SELLER": {
            "type": "integer"
          }
        },
        "required": ["ACCEPTED", "CANCELLED_BY_SELLER", "DELIVERED", "NEW", "SHIPPED"]
      },
      "SubOrderHistory": {
        "type": "object",
        "properties": {
          "from_status": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/SubOrderStatusEnum"
              },
              {
                "$ref": "#/components/schemas/NullEnum"
              }
            ]
          },
          "to_status": {
            "$ref": "#/components/schemas/SubOrderStatusEnum"
          },
          "reason": {
            "type": "string",
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": ["created_at", "from_status", "reason", "to_status"]
      },
      "SubOrderStatusEnum": {
        "enum": ["NEW", "ACCEPTED", "SHIPPED", "DELIVERED", "CANCELLED_BY_SELLER"],
        "type": "string",
        "description": "* `NEW` - New\n* `ACCEPTED` - Accepted\n* `SHIPPED` - Shipped\n* `DELIVERED` - Delivered\n* `CANCELLED_BY_SELLER` - Cancelled_By_Seller"
      },
      "SubOrderTargetStatusEnum": {
        "enum": ["ACCEPTED", "SHIPPED", "DELIVERED", "CANCELLED_BY_SELLER"],
        "type": "string",
        "description": "* `ACCEPTED` - Accepted\n* `SHIPPED` - Shipped\n* `DELIVERED` - Delivered\n* `CANCELLED_BY_SELLER` - Cancelled_By_Seller"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
