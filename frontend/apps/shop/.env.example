# Base URL of the API. The gateway also answers on the shop's own origin, which keeps the cart's
# guest cookie first-party. Copy to .env.local to override.
VITE_API_URL=http://shop.localhost

# "true" shows the dev-only "To'lash (test)" mock payment button in production builds (it is
# always shown by the Vite dev server). Only useful when the order service has mock payments on.
VITE_MOCK_PAYMENT=false
